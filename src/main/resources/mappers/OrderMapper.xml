<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.gmpark.cors.mappers.OrderMapper">
    <insert id="insertOrder" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `cors`.`orders` (
            `user_email`, `total_price`, `status`, `created_at`,
            `receiver_name`, `receiver_phone`, `address`, `address_detail`, `request`
        ) VALUES (
            #{userEmail}, #{totalPrice}, #{status}, NOW(),
            #{receiverName}, #{receiverPhone}, #{address}, #{addressDetail}, #{request}
        )
    </insert>

    <insert id="insertOrderItems">
        INSERT INTO `cors`.`order_items` (
            `order_id`, `item_id`, `size`, `quantity`, `price`
        ) VALUES
        <foreach collection="items" item="item" separator=",">
            (#{item.orderId}, #{item.itemId}, #{item.size}, #{item.quantity}, #{item.price})
        </foreach>
    </insert>
</mapper>
