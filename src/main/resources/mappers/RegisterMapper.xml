<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="dev.gmpark.cors.mappers.RegisterMapper">
    <insert id="insertRegister"
            useGeneratedKeys="true"
            keyColumn="id"
            keyProperty="id">
        INSERT INTO `cors`.`users`(`name`,`storeName`,`businessNum`,`usertype`,`email`,`password`,`phone`,`address`,`addressDetail`,`gender`)
        VALUES (#{register.name},
                #{register.storeName},
                #{register.businessNum},
                #{register.usertype},
                #{register.email},
                #{register.password},
                #{register.phone},
                #{register.address},
                #{register.addressDetail},
                #{register.gender}
               )
    </insert>
    <select id="selectUser" resultType="dev.gmpark.cors.entities.RegisterEntity">
    SELECT `name` AS `name`
         ,`storeName` AS `storeName`
         ,`businessNum` AS `bubusinessNum`
         ,`usertype` AS `usertype`
         ,`email` AS `email`
         ,`password` AS `password`
         ,`phone` AS `phone`
         ,`address` AS `address`
         ,`addressDetail` AS `addressDetail`
         ,`gender` AS `gender`
    FROM `cors`.`users`
    WHERE email = #{email} AND password = #{password}
    </select>

</mapper>

